{
  "name": "ideomy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "biome check . && node scripts/check-boundaries.mjs",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:contract": "vitest run packages/schema/src/schema.contract.test.ts packages/contracts/src/protocol.contract.test.ts",
    "eval:retrieval": "node --experimental-transform-types scripts/run-retrieval-evals.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/generate-schemas.mjs && pnpm --filter @ideomy/obsidian-plugin build",
    "validate:schemas": "node scripts/validate-artifacts.mjs schemas",
    "validate:fixtures": "node scripts/validate-artifacts.mjs fixtures",
    "validate:contracts": "node scripts/validate-artifacts.mjs contracts",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@ideomy/cli": "workspace:*",
    "@ideomy/contracts": "workspace:*",
    "@ideomy/core": "workspace:*",
    "@ideomy/core-client": "workspace:*",
    "@ideomy/platform": "workspace:*",
    "@biomejs/biome": "2.5.0",
    "@types/node": "24.7.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "yaml": "2.8.1",
    "zod": "4.6.0"
  }
}
