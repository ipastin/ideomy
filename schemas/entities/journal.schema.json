{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideomy.local/schema/entities/journal.schema.json",
  "title": "Ideomy journal frontmatter",
  "allOf": [
    {
      "$ref": "../base.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "journal"
        },
        "id": {
          "pattern": "^jrn_"
        },
        "status": {
          "enum": [
            "open",
            "reviewed",
            "closed"
          ]
        },
        "subtype": {
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "quarterly",
            "yearly"
          ]
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "period_start": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "period_end": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "status",
        "subtype"
      ],
      "additionalProperties": true
    }
  ]
}
