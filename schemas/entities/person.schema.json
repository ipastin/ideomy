{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideomy.local/schema/entities/person.schema.json",
  "title": "Ideomy person frontmatter",
  "allOf": [
    {
      "$ref": "../base.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "person"
        },
        "id": {
          "pattern": "^per_"
        },
        "status": {
          "enum": [
            "active",
            "dormant",
            "archived"
          ]
        },
        "relationship_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "last_interaction": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_follow_up": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "status"
      ],
      "additionalProperties": true
    }
  ]
}
