{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideomy.local/schema/entities/meeting.schema.json",
  "title": "Ideomy meeting frontmatter",
  "allOf": [
    {
      "$ref": "../base.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "meeting"
        },
        "status": {
          "enum": [
            "scheduled",
            "completed",
            "processed",
            "cancelled"
          ]
        },
        "subtype": {
          "enum": [
            "work",
            "1on1",
            "interview",
            "research-interview",
            "client-call",
            "review",
            "mentoring",
            "networking",
            "personal",
            "other"
          ]
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "start_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "end_time": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "status",
        "date"
      ],
      "additionalProperties": true
    }
  ]
}
