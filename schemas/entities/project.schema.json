{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideomy.local/schema/entities/project.schema.json",
  "title": "Ideomy project frontmatter",
  "allOf": [
    {
      "$ref": "../base.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "project"
        },
        "id": {
          "pattern": "^prj_"
        },
        "status": {
          "enum": [
            "idea",
            "planned",
            "active",
            "waiting",
            "paused",
            "completed",
            "cancelled"
          ]
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "definition_of_done": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "started": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "completed": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "status",
        "primary_area",
        "outcome"
      ],
      "additionalProperties": true
    }
  ]
}
