{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "session_token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$"
    },
    "core_instance_id": {
      "type": "string"
    },
    "vault_id": {
      "type": "string"
    }
  },
  "required": [
    "session_token",
    "expires_at",
    "core_instance_id",
    "vault_id"
  ],
  "additionalProperties": false,
  "$id": "https://ideomy.local/protocol/v1/auth-session-response.schema.json"
}
