{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideomy.local/protocol/v1/error-envelope.schema.json",
  "type": "object",
  "required": [
    "ok",
    "error"
  ],
  "properties": {
    "ok": {
      "const": false
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "category",
        "message",
        "retryable",
        "request_id"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "request_id": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
