{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideomy.local/protocol/v1/operation.schema.json",
  "type": "object",
  "required": [
    "operation_id",
    "state",
    "kind",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "operation_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "waiting_review",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "kind": {
      "type": "string"
    },
    "stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "progress": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$"
    },
    "result": {},
    "error": {}
  },
  "additionalProperties": false
}
