{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideomy.local/protocol/v1/review-item.schema.json",
  "type": "object",
  "required": [
    "id",
    "kind",
    "risk",
    "state",
    "created_at",
    "proposal"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "state": {
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "stale",
        "conflict"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "proposal": {
      "type": "object"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_hash": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
