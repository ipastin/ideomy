{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bootstrap_proof": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$"
    }
  },
  "required": [
    "bootstrap_proof",
    "expires_at"
  ],
  "additionalProperties": false,
  "$id": "https://ideomy.local/protocol/v1/pair-window-response.schema.json"
}
